{
  "name": "soumya-rpc",
  "version": "0.1.1",
  "description": "Dead-simple, type-safe RPC between microservices over RabbitMQ",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "rpc",
    "rabbitmq",
    "amqp",
    "microservices",
    "typescript",
    "bun"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:bun": "bun test tests/bun",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "amqplib": "^2.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.4.2",
    "@types/node": "^20.19.43",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
